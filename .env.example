# Global listener configuration. Site definitions live in sites.json.
# DNS providers are independent of whether traffic reaches Sentinel directly
# or through a trusted HTTP proxy.
# Bind only the public IPv4 address so Tailscale Serve can retain its
# separate tailnet-only HTTPS listener on port 443.
PUBLIC_LISTEN_ADDR=203.0.113.10
# Optional explicit IPv6 address assigned to this server (never ::).
PUBLIC_LISTEN_IPV6=
# Tailscale is optional. Match tailscaled --tun when using a custom Linux TUN.
# Used by host checks AND the container startup guard; never a public listener.
TAILSCALE_INTERFACE=tailscale0

# direct: ordinary DNS A/AAAA records, including Cloudflare DNS-only.
# cloudflare: orange-cloud proxy, source ACL + CF-Connecting-IP.
# trusted-proxy: another CDN/load balancer with explicitly trusted CIDRs.
EDGE_MODE=direct
# Docker container which owns every SafeLine business listener.
SAFELINE_CONTAINER=safeline-tengine
TRUSTED_PROXY_CIDRS=
REAL_IP_HEADER=X-Forwarded-For

# Local liveness endpoint, independent of public TLS, DNS and proxy ACLs.
HEALTHCHECK_PORT=18090

# Optional ingress interface/alias check and firewall helper; not assumed eth0.
# Inspect the firewall plan before applying. No SSH/UFW reset.
PUBLIC_INTERFACE=

# Host directory mounted read-only at /etc/sentinel/tls inside the container.
# Every certificate/private_key path in sites.json must be located below it.
TLS_MOUNT_ROOT=/etc/sentinel/tls

# Certificate used only by the TLS default server that rejects unknown Hosts.
# It may reuse one site certificate, but every proxy/redirect site declares
# its own paths in sites.json. Keep certificate material outside this repo.
DEFAULT_TLS_CERT_PATH=/etc/sentinel/tls/app.example.com/fullchain.pem
DEFAULT_TLS_KEY_PATH=/etc/sentinel/tls/app.example.com/privkey.pem
